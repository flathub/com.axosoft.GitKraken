{
    "id": "com.axosoft.GitKraken",
    "runtime": "org.freedesktop.Sdk",
    "runtime-version": "25.08",
    "sdk": "org.freedesktop.Sdk",
    "base": "org.electronjs.Electron2.BaseApp",
    "base-version": "25.08",
    "command": "gitkraken",
    "tags": [
        "proprietary"
    ],
    "separate-locales": false,
    "finish-args": [
        "--require-version=0.11.1",
        "--share=ipc",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--socket=pulseaudio",
        "--socket=ssh-auth",
        "--socket=pcsc",
        "--share=network",
        "--device=dri",
        "--filesystem=home",
        "--filesystem=/mnt",
        "--filesystem=/media",
        "--filesystem=/run/media",
        "--filesystem=xdg-run/gvfs",
        "--filesystem=xdg-run/gvfsd",
        "--talk-name=org.gtk.vfs.*",
        "--talk-name=org.freedesktop.Notifications",
        "--talk-name=org.freedesktop.secrets",
        "--env=XCURSOR_PATH=run/host/user-share/icons:/run/host/share/icons"
    ],
    "modules": [
        {
            "name": "ImageMagick",
            "config-opts": [
                "--enable-static=no",
                "--with-modules",
                "--disable-docs",
                "--disable-deprecated",
                "--without-autotrace",
                "--without-bzlib",
                "--without-djvu",
                "--without-dps",
                "--without-fftw",
                "--without-fontconfig",
                "--without-fpx",
                "--without-freetype",
                "--without-gvc",
                "--without-jbig",
                "--without-jpeg",
                "--without-lcms",
                "--without-lzma",
                "--without-magick-plus-plus",
                "--without-openexr",
                "--without-openjp2",
                "--without-pango",
                "--without-raqm",
                "--without-tiff",
                "--without-webp",
                "--without-wmf",
                "--without-x",
                "--without-xml",
                "--without-zlib"
            ],
            "cleanup": [
                "*"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/ImageMagick/ImageMagick/archive/7.1.2-34.tar.gz",
                    "sha256": "f5163a573a1c1bff16358d0a592b2fb168ad0fd3b9dc5ff57dc7820eebc5cf79",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 1372,
                        "stable-only": true,
                        "url-template": "https://github.com/ImageMagick/ImageMagick/archive/${version}.tar.gz"
                    }
                }
            ]
        },
        {
            "name": "krb5",
            "subdir": "src",
            "buildsystem": "autotools",
            "config-opts": [
                "--localstatedir=/var/lib",
                "--sbindir=${FLATPAK_DEST}/bin",
                "--disable-static",
                "--disable-rpath"
            ],
            "cleanup": [
                "/bin",
                "/include",
                "/lib/pkgconfig",
                "/sbin",
                "/share/et",
                "/share/examples",
                "/share/man",
                "/var"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/krb5/krb5/archive/refs/tags/krb5-1.22.2-final.tar.gz",
                    "sha256": "289f5bb81d1f2f8d5eecebe56a056aeed95d35fd9bb4a7071c5dd7ad4b3fe888",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 13287,
                        "stable-only": true,
                        "url-template": "https://github.com/krb5/krb5/archive/refs/tags/krb5-$version.tar.gz"
                    }
                },
                {
                    "type": "shell",
                    "dest": "src",
                    "commands": [
                        "autoreconf -si"
                    ]
                }
            ]
        },
        {
            "name": "krb5-config",
            "buildsystem": "simple",
            "build-commands": [
                "install -Dm0644 krb5.conf -t /app/etc/"
            ],
            "sources": [
                {
                    "type": "file",
                    "path": "files/krb5/krb5.conf"
                }
            ]
        },
        {
            "name": "pcsc-lite",
            "buildsystem": "meson",
            "config-opts": [
                "-Dlibsystemd=false",
                "-Dlibudev=false",
                "-Dlibusb=false",
                "-Dpolkit=false",
                "-Dserial=false",
                "-Dsystemdunit=user",
                "-Dusb=false"
            ],
            "cleanup": [
                "/include",
                "/lib/pkgconfig"
            ],
            "post-install": [
                "rm /app/sbin/pcscd",
                "rmdir /app/sbin || true"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://salsa.debian.org/rousseau/PCSC/-/archive/2.5.3/PCSC-2.5.3.tar.bz2",
                    "sha256": "d5e7a3a7d4243378c612233ef6681edaccab4ae509151f02d2040643f3b7e740",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 2611,
                        "stable-only": true,
                        "url-template": "https://salsa.debian.org/rousseau/PCSC/-/archive/$version/PCSC-$version.tar.bz2"
                    }
                }
            ]
        },
        {
            "name": "git-lfs",
            "buildsystem": "simple",
            "build-commands": [
                "PREFIX=${FLATPAK_DEST} ./install.sh"
            ],
            "sources": [
                {
                    "type": "archive",
                    "only-arches": [
                        "x86_64"
                    ],
                    "strip-components": 1,
                    "url": "https://github.com/git-lfs/git-lfs/releases/download/v3.8.1/git-lfs-linux-amd64-v3.8.1.tar.gz",
                    "sha256": "e72cf723a4a660438862282e8aecf3885fc8123e88bfcad534cf6b941a354b75",
                    "x-checker-data": {
                        "type": "json",
                        "url": "https://api.github.com/repos/git-lfs/git-lfs/releases/latest",
                        "url-query": ".assets[] | select(.name==\"git-lfs-linux-amd64-\" + $version + \".tar.gz\") | .browser_download_url",
                        "version-query": ".tag_name"
                    }
                },
                {
                    "type": "archive",
                    "only-arches": [
                        "aarch64"
                    ],
                    "strip-components": 1,
                    "url": "https://github.com/git-lfs/git-lfs/releases/download/v3.8.1/git-lfs-linux-arm64-v3.8.1.tar.gz",
                    "sha256": "67895dd77b63329796bc5efdd47b57f218e1f7b98717ebaf936a8238dbcaec0f",
                    "x-checker-data": {
                        "type": "json",
                        "url": "https://api.github.com/repos/git-lfs/git-lfs/releases/latest",
                        "url-query": ".assets[] | select(.name==\"git-lfs-linux-arm64-\" + $version + \".tar.gz\") | .browser_download_url",
                        "version-query": ".tag_name"
                    }
                }
            ]
        },
        {
            "name": "gitkraken",
            "buildsystem": "simple",
            "build-commands": [
                ". ${FLATPAK_BUILDER_BUILDDIR}/build"
            ],
            "sources": [
                {
                    "type": "file",
                    "path": "apply_extra.sh"
                },
                {
                    "type": "file",
                    "path": "gitkraken-build.sh",
                    "dest-filename": "build"
                },
                {
                    "type": "file",
                    "path": "gitkraken.sh"
                },
                {
                    "type": "file",
                    "path": "com.axosoft.GitKraken.metainfo.xml"
                },
                {
                    "type": "file",
                    "only-arches": [
                        "x86_64"
                    ],
                    "dest-filename": "gitkraken.deb",
                    "url": "https://api.gitkraken.dev/releases/production/linux/x64/12.6.1/gitkraken-amd64.deb",
                    "sha256": "83c2d39b1a33aa0ac27ecfcdc71f8f55f116f3a45da06188a7ce2597a0f10fba",
                    "x-checker-data": {
                        "type": "html",
                        "url": "https://help.gitkraken.com/gitkraken-desktop/current/",
                        "version-pattern": "Version ((?:\\d+\\.)?(?:\\d+\\.)?\\d+)",
                        "url-template": "https://api.gitkraken.dev/releases/production/linux/x64/$version/gitkraken-amd64.deb"
                    }
                },
                {
                    "type": "file",
                    "only-arches": [
                        "aarch64"
                    ],
                    "dest-filename": "gitkraken.deb",
                    "url": "https://api.gitkraken.dev/releases/production/linux/arm64/12.6.1/gitkraken-aarch64.deb",
                    "sha256": "9de8565b9cd32163acf4e2c3f26a424ea1994ba5efade362aaa513659ea8f923",
                    "x-checker-data": {
                        "type": "html",
                        "url": "https://help.gitkraken.com/gitkraken-desktop/current/",
                        "version-pattern": "Version ((?:\\d+\\.)?(?:\\d+\\.)?\\d+)",
                        "url-template": "https://api.gitkraken.dev/releases/production/linux/arm64/$version/gitkraken-aarch64.deb"
                    }
                },
                {
                    "type": "extra-data",
                    "only-arches": [
                        "x86_64"
                    ],
                    "filename": "gitkraken.deb",
                    "url": "https://api.gitkraken.dev/releases/production/linux/x64/12.6.1/gitkraken-amd64.deb",
                    "sha256": "83c2d39b1a33aa0ac27ecfcdc71f8f55f116f3a45da06188a7ce2597a0f10fba",
                    "size": 153238032,
                    "x-checker-data": {
                        "type": "html",
                        "url": "https://help.gitkraken.com/gitkraken-desktop/current/",
                        "version-pattern": "Version ((?:\\d+\\.)?(?:\\d+\\.)?\\d+)",
                        "url-template": "https://api.gitkraken.dev/releases/production/linux/x64/$version/gitkraken-amd64.deb",
                        "is-main-source": true
                    }
                },
                {
                    "type": "extra-data",
                    "only-arches": [
                        "aarch64"
                    ],
                    "filename": "gitkraken.deb",
                    "url": "https://api.gitkraken.dev/releases/production/linux/arm64/12.6.1/gitkraken-aarch64.deb",
                    "sha256": "9de8565b9cd32163acf4e2c3f26a424ea1994ba5efade362aaa513659ea8f923",
                    "size": 159602124,
                    "x-checker-data": {
                        "type": "html",
                        "url": "https://help.gitkraken.com/gitkraken-desktop/current/",
                        "version-pattern": "Version ((?:\\d+\\.)?(?:\\d+\\.)?\\d+)",
                        "url-template": "https://api.gitkraken.dev/releases/production/linux/arm64/$version/gitkraken-aarch64.deb",
                        "is-main-source": true
                    }
                }
            ]
        }
    ]
}
